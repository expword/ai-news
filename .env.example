PORT=5179
HOST=127.0.0.1

# 后台接口保护。上线后务必改成一串随机字符。
ADMIN_TOKEN=change-me

# 大模型接口：支持 OpenAI-compatible /v1/chat/completions。
# 如果你的服务给的是完整 endpoint，也可以额外配置 LLM_ENDPOINT。
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com
LLM_MODEL=gpt-4.1-mini
LLM_ENDPOINT=
# 控制并发和单次最大输出，避免瞬时请求与异常长输出放大费用。
LLM_WORKERS=8
LLM_MAX_TOKENS=1200
# 第三方兼容接口不支持 response_format 时设为 0；默认不做可能产生双倍费用的回退重试。
LLM_JSON_MODE=1
LLM_RETRY_WITHOUT_JSON=0
ARTICLE_MAX_CHARS=2800

# 可选：真正联网搜索用。没有这些 key 时，后台仍会用 GitHub API 和预设信息源生成内容。
SEARCH_PROVIDER=
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
GITHUB_TOKEN=

# 可选：Python 后端会读取这些免费搜索/新闻 API，并交给大模型提取摘要。
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
NEWSAPI_KEY=
GNEWS_API_KEY=
NEWSDATA_API_KEY=
GUARDIAN_API_KEY=
CURRENTS_API_KEY=
WORLDNEWS_API_KEY=
MARKETAUX_API_KEY=
FREENEWSAPI_KEY=
NEWSDATAHUB_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
# 逗号分隔：newsapi,gnews,newsdata,guardian,currents,worldnews,marketaux。
# 默认只启用一个主新闻 API；RSS 和官网采集仍会正常运行。
NEWS_API_PROVIDERS=newsapi
NEWS_API_QUERY_LIMIT=3

# 定时任务使用服务器本地时区。你电脑当前是 Asia/Shanghai。
# 新闻每小时检查；GitHub 每 6 小时；Skill 每天一次。
CRAWL_INTERVAL_MINUTES=60
GITHUB_INTERVAL_MINUTES=360
SKILL_INTERVAL_MINUTES=1440
NEWS_ENRICH_LIMIT=12
GITHUB_ENRICH_LIMIT=12
SKILL_ENRICH_LIMIT=12
# 批量 Skill 每周刷新一次，只翻译从未处理过的新 URL。
SKILL_SEED_INTERVAL_DAYS=7
SKILL_SEED_TARGET=100
# 每天几点把"昨天"的精选固化成带日期的日报存入归档（每日日报）。默认 0 点。
DAILY_REPORT_TIME=00:00
# 每周周报（GitHub / Skill）。WEEKLY_DAY：周一=1 … 周日=7。
WEEKLY_DAY=1
WEEKLY_TIME=09:30

# —— 自动推送到 GitHub（触发 Vercel 重新部署）——
# 在常驻运行的电脑上设为 1 开启：每次有新数据时自动 git 提交并推送。
AUTO_GIT_PUSH=0
# 150 分钟约等于每天 9.6 次；只有数据真正变化时才会推送。
GIT_PUSH_INTERVAL_MINUTES=150
# 推送到哪个远程/分支（默认 origin / main）。
GIT_REMOTE=origin
GIT_BRANCH=main

# —— 自动拉取代码 + 自重启（免手动同步）——
# 在常驻运行的电脑上设为 1 开启：定期 git pull，检测到 backend.py 变化时自动重启加载新代码。
# 这样在开发机改完代码 push 后，本机会自动跟上，无需手动 pull / 重启。
AUTO_GIT_PULL=0
# 拉取周期：至少间隔多少分钟拉一次。默认 5 分钟。
GIT_PULL_INTERVAL_MINUTES=5
